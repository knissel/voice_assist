[Unit]
Description=Voice Assistant Legacy UI Server
After=network.target

[Service]
Type=simple
User=knissel
Group=knissel
WorkingDirectory=/home/knissel/voice_assist
Environment=PATH=/home/knissel/voice_assist/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# Legacy UI server is in legacy/
ExecStart=/home/knissel/voice_assist/.venv/bin/python legacy/ui_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
